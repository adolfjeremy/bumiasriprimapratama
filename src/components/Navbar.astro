---
import { Image } from "astro:assets";
import logo from "../assets/images/logo.webp";
import Button from "./Button.astro";

// Ambil props dan pathname
const { isTransparent } = Astro.props;
const pathname = Astro.url.pathname;

// Logika: Transparan jika prop isTransparent bernilai true
// ATAU jika berada di halaman detail news (/news/slug)
const shouldBeTransparent = isTransparent || /^\/news\/.+/.test(pathname);

const links = [
  { name: "Home", href: "/" },
  { name: "About Us", href: "/about-us" },
  { name: "Services", href: "/services" },
  { name: "News", href: "/news" },
  { name: "Contact Us", href: "/contact" },
];

const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<header
  class:list={[
    "absolute top-0 left-0 right-0 w-full z-50 px-[16px] md:px-[64px] lg:px-[80px] transition-all duration-300",
    shouldBeTransparent ? "bg-transparent" : "bg-black/30 backdrop-blur-xs",
  ]}
>
  <div class="mx-auto py-4 flex items-center justify-between">
    <!-- LOGO -->
    <div class="flex items-center gap-2">
      <a href="/">
        <Image
          src={logo}
          alt="BAPP"
          class="w-26 md:w-36 h-auto"
          fetchpriority="high"
          quality={90}
          format="webp"
          loading="lazy"
        />
      </a>
    </div>

    <!-- DESKTOP NAV -->
    <nav class="hidden md:flex items-center gap-8 text-[#fafafa] text-base">
      {
        links.map((item) => (
          <a
            href={item.href}
            class:list={[
              "nav-link hover:text-[#0077cc]",
              { active: isActive(item.href) },
            ]}
          >
            {item.name}
          </a>
        ))
      }
    </nav>

    <!-- CTA -->
    <div class="hidden lg:block">
      <Button text="Company Profile" href="/compro-bapp.pdf" target="_blank" />
    </div>

    <!-- MOBILE MENU BUTTON -->
    <button
      id="menuBtn"
      class="md:hidden relative z-55 w-8 h-8 flex flex-col justify-center gap-1.5"
      aria-label="Open Menu"
    >
      <span class="line"></span>
      <span class="line"></span>
      <span class="line"></span>
    </button>
  </div>

  <!-- MOBILE DRAWER -->
  <div id="drawer" class="fixed top-0 bottom-0 left-0 h-[100svh] z-50 hidden">
    <div
      id="backdrop"
      class="absolute inset-0 w-[100svw] h-[100svh] bg-black/50"
    >
    </div>
    <div
      id="drawerPanel"
      class="absolute left-0 top-0 h-full w-72 bg-[#F3EFFE] p-6 flex flex-col items-center justify-center gap-6 transform -translate-x-full transition-[transform,opacity] duration-300 ease-out opacity-0"
    >
      <nav
        class="flex flex-col gap-4 text-[#141219] text-lg text-center mobile-nav"
      >
        {
          links.map((item) => (
            <a
              href={item.href}
              class:list={[
                "nav-link hover:text-[#0077cc]",
                { active: isActive(item.href) },
              ]}
            >
              {item.name}
            </a>
          ))
        }
      </nav>
      <Button text="Company Profile" href="/compro-bapp.pdf" />
    </div>
  </div>
</header>

<style>
  #menuBtn .line {
    height: 4px;
    width: 100%;
    background: #018ff5;
    border-radius: 3px;
    transition:
      transform 0.3s ease,
      opacity 0.2s ease;
  }

  .bg-transparent {
    nav a:hover {
      color: #0077cc !important;
    }
    nav a:not(.active) {
      color: #242424;
    }
  }

  #menuBtn.is-open .line:nth-child(1) {
    transform: translateY(13px) rotate(45deg);
  }

  #menuBtn.is-open .line:nth-child(2) {
    opacity: 0;
  }

  #menuBtn.is-open .line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .mobile-nav .nav-link {
    font-size: 1.6825rem;
  }

  .nav-link {
    transition: color 0.2s ease;
  }

  .nav-link.active {
    color: #018ff5;
    font-weight: 600;
  }
</style>

<script>
  const menuBtn = document.getElementById("menuBtn");
  const drawer = document.getElementById("drawer");
  const drawerPanel = document.getElementById("drawerPanel");
  const backdrop = document.getElementById("backdrop");

  if (menuBtn && drawer && drawerPanel && backdrop) {
    let scrollY = 0;

    const lockScroll = () => {
      scrollY = window.scrollY;
      document.body.style.position = "fixed";
      document.body.style.top = `-${scrollY}px`;
      document.body.style.width = "100%";
    };

    const unlockScroll = () => {
      document.body.style.position = "";
      document.body.style.top = "";
      document.body.style.width = "";
      window.scrollTo(0, scrollY);
    };

    const openDrawer = () => {
      drawer.classList.remove("hidden");
      lockScroll();
      requestAnimationFrame(() => {
        drawerPanel.classList.remove("-translate-x-full");
        drawerPanel.classList.remove("opacity-0");
        menuBtn.classList.add("is-open");
      });
    };

    const closeDrawer = () => {
      drawerPanel.classList.add("-translate-x-full");
      drawerPanel.classList.add("opacity-0");
      menuBtn.classList.remove("is-open");
      unlockScroll();
      setTimeout(() => {
        drawer.classList.add("hidden");
      }, 300);
    };

    menuBtn.addEventListener("click", () => {
      drawer.classList.contains("hidden") ? openDrawer() : closeDrawer();
    });

    backdrop.addEventListener("click", closeDrawer);
    document.querySelectorAll(".mobile-nav a").forEach((link) => {
      link.addEventListener("click", closeDrawer);
    });
  }
</script>
